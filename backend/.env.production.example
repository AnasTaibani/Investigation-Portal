# Backend Production Environment Variables
# These should be set in Render.com dashboard

MONGO_URL=mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=investigation_portal
JWT_SECRET=generate-a-secure-random-string-min-32-chars
EMERGENT_LLM_KEY=your-emergent-key-from-profile
FRONTEND_URL=https://your-app-name.vercel.app
ENVIRONMENT=production
